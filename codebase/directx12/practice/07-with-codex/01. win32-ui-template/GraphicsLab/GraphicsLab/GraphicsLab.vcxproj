  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Generate C byte arrays from HLSL at build time.  The shader headers are
       included directly in TriangleExperiment.cpp, so Release ships one EXE. -->
  <Target Name="CompileShaders" BeforeTargets="ClCompile"
      Inputs="$(MSBuildProjectFullPath);$(ProjectDir)shaders\TriangleVS.hlsl;$(ProjectDir)shaders\TrianglePS.hlsl"
      Outputs="$(IntDir)TriangleVS.h;$(IntDir)TrianglePS.h">
    <MakeDir Directories="$(IntDir)" />
    <PropertyGroup>
      <ShaderCompiler>$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\fxc.exe</ShaderCompiler>
    </PropertyGroup>
    <Error Condition="!Exists('$(ShaderCompiler)')" Text="FXC was not found at $(ShaderCompiler). Install the Windows SDK shader compiler for SDK $(TargetPlatformVersion)." />
    <Exec Command="&quot;$(ShaderCompiler)&quot; /nologo /T vs_5_1 /E VSMain /Fh &quot;$(IntDir)TriangleVS.h&quot; /Vn g_TriangleVS &quot;$(ProjectDir)shaders\TriangleVS.hlsl&quot;" />
    <Exec Command="&quot;$(ShaderCompiler)&quot; /nologo /T ps_5_1 /E PSMain /Fh &quot;$(IntDir)TrianglePS.h&quot; /Vn g_TrianglePS &quot;$(ProjectDir)shaders\TrianglePS.hlsl&quot;" />
  </Target>
